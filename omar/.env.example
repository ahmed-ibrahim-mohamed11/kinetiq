# ─────────────────────────────────────────────────────────────────────────────
# AI Smart Gym — environment template
# Copy to .env (root, for workers) and apps/*/.env.local (for Next.js apps).
# NEVER commit real values. NEVER expose SERVICE_ROLE keys to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (public, safe for browser) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase (server-only) ───────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-never-in-browser
SUPABASE_DB_URL=postgresql://postgres:password@db.YOUR-PROJECT.supabase.co:5432/postgres

# ── Email fallback (notification-worker; optional) ──────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Smart Gym <reports@your-domain.example>"
MEMBER_APP_URL=https://members.your-domain.example

# ── Web push (notification-worker) ───────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Edge device (services/edge-ai) ───────────────────────────────────────────
EDGE_DEVICE_ID=00000000-0000-0000-0000-000000000000
# Shared HMAC secret issued per device by admin; rotate via edge_devices table.
EDGE_DEVICE_SECRET=
EDGE_INGEST_URL=https://YOUR-PROJECT.supabase.co/functions/v1/ingest-events
EDGE_BRANCH_ID=00000000-0000-0000-0000-000000000000
EDGE_DATA_DIR=./data
EDGE_CAMERAS_FILE=./config/cameras.yaml
EDGE_LOG_LEVEL=INFO
EDGE_HEALTH_PORT=8088
EDGE_METRICS_PORT=9108
# Encryption key for biometric templates at rest (32 bytes, base64). Keep on device only.
EDGE_BIOMETRIC_KEY_B64=

# ── Edge Functions (set via `supabase secrets set`) ──────────────────────────
# INGEST_MAX_BATCH=500
# INGEST_CLOCK_SKEW_SECONDS=300
