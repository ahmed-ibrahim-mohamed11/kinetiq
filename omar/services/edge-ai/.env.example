# Edge AI service — copy to .env on the edge device. Never commit .env.
EDGE_DEVICE_ID=d0000000-0000-4000-8000-000000000001
EDGE_BRANCH_ID=b0000000-0000-4000-8000-000000000001
# Dev-only secret matching supabase/seed.sql. Issue a real one with issue_device_secret() in production.
EDGE_DEVICE_SECRET=dev-only-device-secret-change-me
EDGE_INGEST_URL=http://127.0.0.1:54321/functions/v1/ingest-events
EDGE_DATA_DIR=./data
EDGE_CAMERAS_FILE=./config/cameras.yaml
EDGE_CAMERA_SECRETS_FILE=./config/camera-credentials.yaml
EDGE_LOG_LEVEL=INFO
EDGE_HEALTH_PORT=8088
EDGE_SYNC_INTERVAL_SECONDS=2
EDGE_SYNC_BATCH_SIZE=200
EDGE_INFERENCE_FPS=10
# 32 random bytes, base64. Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
EDGE_BIOMETRIC_KEY_B64=
# Cloud config sync (defaults to <ingest base>/device-sync)
EDGE_SYNC_URL=
EDGE_CONFIG_SYNC_INTERVAL_SECONDS=300
# ONNX models (leave empty to disable a stage)
EDGE_DETECTOR_MODEL_PATH=
EDGE_POSE_MODEL_PATH=
EDGE_REID_MODEL_PATH=
EDGE_FACE_MODEL_PATH=
