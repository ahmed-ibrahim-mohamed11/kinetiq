# --- environments / secrets ---
.venv/
.env
.env.*
!.env.example
__pycache__/
*.pyc
.pytest_cache/

# --- large binaries: dataset videos + model weights (see docs/HARDWARE_SETUP.md, ai/models/README.md) ---
