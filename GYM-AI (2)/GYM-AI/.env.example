# GYM-AI environment template. Copy to .env (git-ignored) and fill in. NEVER commit real keys.

# --- Supabase (Phase 3+) -----------------------------------------------------
# Project URL + anon (publishable) key: safe for the browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Service-role key: SERVER ONLY (edge ingestion, migrations, tests). Never in browser code,
# never in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Postgres connection string for migrations / RLS tests (Supabase dashboard -> Database -> Connect)
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Edge agent (Phase 5+) ---------------------------------------------------
GYM_AI_DEVICE_ID=
GYM_AI_DEVICE_API_KEY=
GYM_AI_INGEST_URL=https://YOUR-PROJECT.supabase.co/functions/v1/ingest
